---
import type { CollectionEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import ResearchEntry from '../../../../../src/components/ResearchEntry.astro';
import '../../../../../src/styles/global.css';
import 'katex/dist/katex.min.css';

const renderer = await createMarkdownProcessor();
const { code } = await renderer.render(`#### Model

This test fixture renders the production research components with supplied media.

#### Main result

The browser checks clip selection, playback, captions, and missing media.

#### Interpretation

These fixture descriptions are test data and are not part of the website.`);

const common = {
  collection: 'research' as const,
  rendered: { html: code },
  data: {
    title: 'Two-clip research fixture',
    authors: ['Fixture author'],
    status: 'Browser test fixture',
    order: 1,
    summary: 'Exercises the actual two-clip component branch.',
    needsReview: false,
    links: [],
    thumbnail: null,
    media: [
      {
        label: 'First supplied clip',
        src: '/media/vor_perc_clust-web.mp4',
        poster: '/media/vor_perc_clust-poster.jpg',
        caption: 'First fixture caption: the supplied percolation clip.',
      },
      {
        label: 'Second supplied clip',
        src: '/media/hyperbolic-poisson-voronoi-web.mp4',
        poster: '/media/hyperbolic-poisson-voronoi-poster.webp',
        caption: 'Second fixture caption: the supplied hyperbolic clip.',
      },
    ],
  },
};
const multipleClips: CollectionEntry<'research'> = { ...common, id: 'fixture-multiple-clips' };
const missingMedia: CollectionEntry<'research'> = {
  ...common,
  id: 'fixture-missing-media',
  data: { ...common.data, title: 'Missing-media research fixture', order: 2, media: [] },
};
const mathematicalCaptions: CollectionEntry<'research'> = {
  ...common,
  id: 'fixture-math-captions',
  data: {
    ...common.data,
    title: 'Mathematical-caption research fixture',
    order: 3,
    summary: 'Exercises build-time math rendering and clip changes.',
    media: [
      {
        ...common.data.media[0],
        label: 'First mathematics clip',
        caption: String.raw`First mathematical caption: a cell in $\mathbb{H}^3$ at intensity $\lambda>0$.`,
      },
      {
        ...common.data.media[1],
        label: 'Second mathematics clip',
        caption: String.raw`Second mathematical caption: $p_u(\lambda)\ge c_d>0$ for $d\ge3$.`,
      },
    ],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Research media browser fixture</title>
  </head>
  <body>
    <div class="site-shell">
      <main id="main">
        <h1>Research media browser fixture</h1>
        <section id="research" aria-labelledby="fixture-heading">
          <h2 id="fixture-heading">Research fixtures</h2>
          <ResearchEntry entry={multipleClips} />
          <ResearchEntry entry={missingMedia} />
          <ResearchEntry entry={mathematicalCaptions} />
        </section>
      </main>
    </div>
    <script src="../../../../../src/lib/research.ts"></script>
  </body>
</html>
