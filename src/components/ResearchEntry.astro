---
import type { CollectionEntry } from 'astro:content';
import ResearchMedia from './ResearchMedia.astro';
import { profile } from '../data/profile';
import { assetUrl } from '../lib/site';
import { researchContent } from '../lib/research-content';
interface Props { entry: CollectionEntry<'research'> }
const { entry } = Astro.props;
const { model, mainResult, interpretation } = researchContent(entry);
const { data, id } = entry;
const preprint = data.status === 'Preprint'
  ? data.links.find(link => /^https:\/\/arxiv\.org\//.test(link.url))
  : undefined;
const statusReference = !preprint ? data.links.find(link => link.statusPrefix !== undefined) : undefined;
const otherLinks = data.links.filter(link => link !== preprint && link !== statusReference);
---
<article class="research-entry" id={id} aria-labelledby={`${id}-title`}>
  <div class="research-heading">
    <div class="entry-metadata">
      <h3 id={`${id}-title`}>{data.title}</h3>
      <p class="coauthors">With {data.authors.join(', ')}</p>
      <p class="paper-status">{preprint ? <a class="preprint-link" href={preprint.url} target="_blank" rel="noopener noreferrer">Preprint: arXiv</a> : <>{data.status}{statusReference && <>{statusReference.statusPrefix}<a href={assetUrl(statusReference.url)} target="_blank" rel="noopener noreferrer">{statusReference.label}</a></>}</>}</p>
      <p class="paper-summary">{data.summary}</p>
      {otherLinks.length > 0 && <div class="paper-links">
        {otherLinks.map(link => <a href={assetUrl(link.url)} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
      </div>}
    </div>
    {profile.showResearchThumbnails && data.thumbnail && <img class="research-thumbnail" src={assetUrl(data.thumbnail.src)} alt={data.thumbnail.alt} width="140" height="100" loading="lazy" />}
  </div>
  <details class="research-details">
    <summary class="details-toggle"><span class="details-open-label">{data.media.length > 0 ? 'Details and animation' : 'Details'}</span><span class="details-close-label">Close details</span><span class="visually-hidden">: {data.title}</span></summary>
    <div class:list={['expanded-research', { 'expanded-research--with-media': data.media.length > 0 }]}>
      <div class="research-text research-model" set:html={model} />
      <div class="research-text research-results" set:html={mainResult} />
      {data.media.length > 0 && <div class="research-illustration">
        <h4 id={`${id}-illustration`}>Illustration</h4>
        <ResearchMedia clips={data.media} title={data.title} />
      </div>}
      <div class="research-text research-interpretation" set:html={interpretation} />
    </div>
  </details>
</article>
